# Meeting-Ops Frontend Configuration Example
# Copy this file to .env and update with your values

# API Configuration
VITE_API_URL=http://localhost:9050
VITE_WS_URL=ws://localhost:9050

# For production deployment with nginx proxy:
# VITE_API_URL=
# VITE_WS_URL=

# Development settings
VITE_DEBUG=false
VITE_LOG_LEVEL=info