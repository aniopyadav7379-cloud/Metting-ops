# Environment variables for Unicorn Commander

# Backend settings
DATABASE_URL=sqlite:////app/data/meeting_sessions.db
# For PostgreSQL:
# DATABASE_URL=postgresql://unicorn:unicorn_password@postgres:5432/unicorn_commander

# HuggingFace token for speaker diarization
# Get yours at https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=

# Security (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here

# Audio settings
DEFAULT_AUDIO_DEVICE=default
DEFAULT_SAMPLE_RATE=16000

# Storage settings
MAX_RECORDING_SIZE_GB=10
AUTO_CLEANUP_DAYS=30

# Network settings
ALLOWED_ORIGINS=http://localhost,http://localhost:80
# Upload pipeline jobs with no progress beyond this threshold are marked
# failed/retryable by the watchdog. Startup recovery re-enqueues younger jobs.
UPLOAD_WATCHDOG_MINUTES=120
MEETING_RETENTION_ENABLED=false
MEETING_RETENTION_DAYS=0
MEETING_RETENTION_MAX_PER_RUN=500
