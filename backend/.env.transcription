# Transcription-First Mode Configuration
# This makes transcription the primary focus, with audio recording optional

# Primary mode: transcription_first, audio_first, or both
TRANSCRIPTION_MODE=transcription_first

# Buffer settings
BUFFER_DURATION_MINUTES=60        # Keep last 60 minutes in memory
BUFFER_TYPE=redis                  # Use Redis for circular buffer

# Audio settings (OFF by default in transcription-first mode!)
RECORD_AUDIO_DEFAULT=false         # Don't record audio by default
AUDIO_FORMAT=mkv                   # Use MKV when audio IS recorded (better compression)
AUDIO_COMPRESSION=opus             # Use Opus codec for audio compression

# Storage settings
AUTO_SAVE_TRANSCRIPTS=false        # Don't auto-save, wait for user action
AUTO_SAVE_INTERVAL_MINUTES=30      # If auto-save is enabled, interval

# Transcription settings
CHUNK_DURATION_SECONDS=5           # Process 5-second chunks
# NPU acceleration belongs to the UC-1 appliance line (Meeting-Ops-UC1), not this
# product. Live STT runs in the browser; the completion pass runs on Parakeet.
USE_NPU=false

# Benefits of this configuration:
# - 1700x less storage (3KB/min vs 5.3MB/min)
# - Always transcribing, never miss anything
# - Hit "Save Meeting" only when something important happened
# - Optional audio recording for critical meetings
# - MKV format saves 50% storage when audio IS needed