# ============================================================================
# Meeting-Ops (Meeting & Lecture Intelligence) — Environment Configuration
# Copy this file to .env and fill in real values. Never commit the real .env.
# ============================================================================

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
SECRET_KEY=your-32-character-secret-key-here
DATABASE_URL=postgresql://meetingops:meetingops123@localhost:5434/meeting_sessions
REDIS_URL=redis://localhost:6381

# ---------------------------------------------------------------------------
# QDRANT — persistent semantic/vector memory (mandatory core technology)
# ---------------------------------------------------------------------------
# Prefer QDRANT_URL (what the platform-wide compose env uses); QDRANT_HOST/
# QDRANT_PORT are honored as a fallback for older deployments.
QDRANT_URL=http://localhost:6333
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# ---------------------------------------------------------------------------
# OMI — real-world voice/ambient meeting input (mandatory core technology)
# ---------------------------------------------------------------------------
# No connection settings needed here — Omi is a webhook PUSH integration
# (docs.omi.me/doc/developer/apps/Integrations), authenticated per-org via a
# Personal Access Token with scope=omi.transcript.ingest (create one under
# Settings -> Personal Access Tokens, or POST /api/auth/pats). Paste the
# resulting URLs into your Omi Integration App's webhook fields:
#   Real-Time Transcript: https://<your-host>/api/v1/integrations/omi/<token>/realtime-transcript
#   Memory Creation:      https://<your-host>/api/v1/integrations/omi/<token>/memory-created
# See docs/omi-integration.md for why the token is in the URL PATH rather
# than a header or query parameter.

# ---------------------------------------------------------------------------
# LYZR — AI orchestration, retrieval reasoning, intelligence generation
# (mandatory core technology)
# ---------------------------------------------------------------------------
# Selectable per-organization as an LLM provider in Settings -> Provider
# Settings (provider_name="lyzr"). The API key itself is entered there (per
# org, encrypted at rest) — these two IDs are account-level and cannot be
# looked up automatically, so they're environment configuration instead:
#   1. Create an LLM credential in your Lyzr Studio account (Settings ->
#      LLM Credentials) -> copy its id into LYZR_LLM_CREDENTIAL_ID.
#   2. Note the provider id shown alongside it -> LYZR_PROVIDER_ID.
# Without both set, selecting "lyzr" as a provider reports itself as
# unavailable (health check) rather than silently no-op.
LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai
LYZR_PROVIDER_ID=
LYZR_LLM_CREDENTIAL_ID=
LYZR_MODEL_ID=gpt-4o-mini

# ---------------------------------------------------------------------------
# LLM (non-Lyzr providers — litellm/openai/anthropic/openrouter/lambda/bedrock)
# ---------------------------------------------------------------------------
# All configured per-organization in Settings -> Provider Settings, same as
# Lyzr above. This is the local/self-hosted fallback used when no
# org-specific provider is set.
LLAMA_CPP_URL=http://localhost:11437

# ---------------------------------------------------------------------------
# EMBEDDINGS
# ---------------------------------------------------------------------------
# Dense embeddings are served by an Infinity-compatible HTTP endpoint;
# sparse (BM25) embeddings use fastembed locally. Configured per-org via the
# same Provider Settings surface as LLM/STT providers — see
# services/providers/registry.py and services/semantic_search_service.py.

# ---------------------------------------------------------------------------
# AUTH
# ---------------------------------------------------------------------------
# Keycloak admin client (OPTIONAL) — lets account self-delete
# (DELETE /api/auth/me) also erase the user's Keycloak SSO identity
# (right-to-erasure). Unset = feature silently off; self-delete still wipes
# all app data, but re-authenticating via SSO re-provisions an empty account.
# Setup: in the realm (uchub), create a confidential client with service
# accounts enabled and assign its service account the realm-management role
# 'manage-users'. See backend/services/keycloak_admin.py.
# KEYCLOAK_ADMIN_BASE falls back to KEYCLOAK_URL; KEYCLOAK_REALM defaults to uchub.
# KEYCLOAK_ADMIN_BASE=
# KEYCLOAK_REALM=
# KEYCLOAK_ADMIN_CLIENT_ID=
# KEYCLOAK_ADMIN_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# STORAGE
# ---------------------------------------------------------------------------
AUDIO_SAMPLE_RATE=44100
AUDIO_DEVICE=hw:0,0
NPU_DEVICE_PATH=/dev/accel/accel0
NPU_MODEL=large-v3
NPU_COMPUTE_TYPE=int8

# CORS (comma-separated origins, leave empty to allow private IPs automatically)
# CORS_ORIGINS=http://192.168.1.100:7777,http://example.com

LOG_LEVEL=INFO
DEBUG=false
UPLOAD_WATCHDOG_MINUTES=120
MEETING_RETENTION_ENABLED=false
MEETING_RETENTION_DAYS=0
MEETING_RETENTION_MAX_PER_RUN=500

# ---------------------------------------------------------------------------
# GOOGLE CALENDAR (OPTIONAL) — the only Phase 3 integration needing env vars,
# because OAuth apps require a fixed redirect URI registered up front.
# ---------------------------------------------------------------------------
# Requires a Google Cloud Console OAuth 2.0 Client (Web application type)
# with the Calendar API enabled and this redirect URI registered:
#   https://<your-host>/api/integrations/google-calendar/callback
# Without all three set, GET /authorize returns 503 rather than a broken flow.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ---------------------------------------------------------------------------
# JIRA / SLACK / MICROSOFT TEAMS / NOTION / TODOIST / CLICKUP / CONFLUENCE / EMAIL
# ---------------------------------------------------------------------------
# None of these eight need environment variables. They're configured at
# runtime, per-organization, from Settings -> Integrations (backed by
# services/integrations/org_config.py — the same encrypted-at-rest,
# per-org credential store Brigade/Project-Ops/Contact-Ops already use):
#   Jira        — base URL (your Atlassian site) + API key as
#                 "your-email@company.com:api-token" (Basic auth)
#   Confluence  — same Atlassian site + email:token format as Jira
#   Todoist     — base URL (https://api.todoist.com) + personal API token
#   ClickUp     — base URL (https://api.clickup.com) + personal API token
#   Notion      — base URL (https://api.notion.com) + internal integration token
#   Slack       — Incoming Webhook URL, entered as the "API base URL" field
#                 (no separate API key — the URL itself is the secret)
#   Teams       — Incoming Webhook (connector) URL, same shape as Slack
#   Email       — SMTP host/port/username/from-address (extra fields in the
#                 Email integration card) + account password as the API key
# See services/integrations/task_providers.py and notifiers.py for the exact
# API contracts, and docs/integrations.md for setup steps per provider.
